"饼~干~"},{"t":656.402,"text":"用最终神器也破不了哟"},{"t":657.681,"text":"好奇为什么到现在稿子还是最初始的"},{"t":658.071,"text":"亮血条吧！"},{"t":658.332,"text":"曾经这个岛上我有一个机刷在里面，我请不了他的蛋也杀不了他"},{"t":659.619,"text":"？刀我是吧……"},{"t":661.245,"text":"进度条危！"},{"t":661.651,"text":"我听成要用饼干面粉糖做饼干了"},{"t":662.593,"text":"《用甜瓜做的糖》"},{"t":664.824,"text":"怒九这句好可爱我天呢"},{"t":665.379,"text":"蛋，糖，杏仁(无端)"},{"t":665.401,"text":"吸溜~"},{"t":665.739,"text":"蘑菇岛按照红橙黄绿青蓝紫敲的话会出现宝箱"},{"t":665.9,"text":"进度条危"},{"t":666.448,"text":"Cookie！"},{"t":666.479,"text":"按顺序打这个彩虹色的蘑菇，他就会爆出一个宝箱"},{"t":667.159,"text":"有点像人头。"},{"t":668.347,"text":"好可爱（指沃玛怒九）"},{"t":669.44,"text":"趣多多"},{"t":669.753,"text":"你有饼吗？"},{"t":671.3,"text":"触发关键词：饼干      Cookies！！！！"},{"t":671.329,"text":"她俩越来越像了"},{"t":673.789,"text":"听得我哈特软软。。。。。"},{"t":674.05,"text":"老玛传下来的手艺（指正）"},{"t":674.662,"text":"进度条危机"},{"t":675.168,"text":"《趣多多》"},{"t":675.241,"text":"体重上升标准配备"},{"t":677.481,"text":"《65点血》"},{"t":678.726,"text":"压缩饼干是吗？"},{"t":679.135,"text":"65点血"},{"t":679.528,"text":"《65点血》"},{"t":681.006,"text":"据说圆圆的东西能回血"},{"t":681.747,"text":"有没有可能红色那个才是？"},{"t":683.475,"text":"我才发现浮岛的血量显示改了"},{"t":683.667,"text":"这银行看着像移动厕所（"},{"t":683.823,"text":"虽然不知道说了多少次了，但是好可爱"},{"t":683.932,"text":"《65点血》"},{"t":686.148,"text":"什么！！！没了！！！！！！！！"},{"t":688.378,"text":"什么时候更新星物谷！"},{"t":693.061,"text":"沃玛躺在怒九上！！"},{"t":693.24,"text":"哇"},{"t":693.764,"text":"！我才发现是手游"},{"t":695.499,"text":"其实很早就有手机端的浮岛物语了"},{"t":695.684,"text":"一个是鱼尾发型的头，一个是两根毛的头"},{"t":696.071,"text":"真的真的超可爱鸭！！！！！！！！"},{"t":697.047,"text":"沃玛躺在怒九上（雾）"},{"t":697.944,"text":"其实switch上更好呢"},{"t":698.578,"text":"拿出手机开始酿酒"},{"t":699.774,"text":"支持铁铁"},{"t":700.978,"text":"这一段台词好像小时候的我会说的…"},{"t":701.574,"text":"好呀好呀"},{"t":703.18,"text":"沃玛怎么分身了"},{"t":704.299,"text":"！我才发现是手游"},{"t":707.321,"text":"好短！"},{"t":707.523,"text":"那个分身可能是怒九"},{"t":709.119,"text":"拜拜~"}]}]}